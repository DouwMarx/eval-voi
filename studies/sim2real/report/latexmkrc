# latexmk configuration for the CoRL 2026 report skeleton.
# The conference style (corl_2026.sty) and bst live in the shared templates dir.
$pdf_mode = 1;            # pdflatex -> PDF
$bibtex_use = 2;          # always run bibtex when needed
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
ensure_path('TEXINPUTS', '../../../templates/corl_2026//');
ensure_path('BSTINPUTS', '../../../templates/corl_2026//');
$clean_ext = 'bbl synctex.gz run.xml';
