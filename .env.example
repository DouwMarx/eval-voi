# Copy to .env (git-ignored).
# Only needed for protocol members with provider: openrouter.
OPENROUTER_API_KEY=
# Optional: wall-clock cap per `claude -p` call in seconds (default 600). A CLI
# whose ANTHROPIC_API_KEY is invalid hangs with no output until this cap.
#VOI_CLI_TIMEOUT_S=600
# Optional: a claude.ai usage-limit outage holds the limited member and
# pauses the run once only held members are left. Without a reset time in
# the CLI's message a pause lasts VOI_OUTAGE_SLEEP_S (default 300); the run
# gives up on a member once it has paused VOI_OUTAGE_MAX_WAIT_S since that
# member's last billed result (default 21600, 6 h: one 5-hour session window
# plus margin; a billed result restarts the budget, so every window of a
# long run gets it).
#VOI_OUTAGE_SLEEP_S=300
#VOI_OUTAGE_MAX_WAIT_S=21600
